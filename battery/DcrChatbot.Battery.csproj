<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Samme User Secrets som Web API'et, så API-nøglerne kun ligger ét sted. -->
    <UserSecretsId>DcrChatbot-WebApi</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\DcrChatbot.Core\DcrChatbot.Core.csproj" />
    <ProjectReference Include="..\src\DcrChatbot.Infrastructure\DcrChatbot.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="results\**" />
    <Compile Remove="results\**" />
  </ItemGroup>

</Project>
